[gd_scene format=3]

[ext_resource type="Script" path="res://features/game/ui/result_screen.gd" id="script"]
[ext_resource type="PackedScene" path="res://features/lobby/join_button.tscn" id="join"]
[ext_resource type="FontFile" path="res://service/assets/ui/theme/PressStart2P.ttf" id="font"]

[sub_resource type="LabelSettings" id="LabelSettings_title"]
resource_local_to_scene = true
font = ExtResource("font")
font_size = 16

[sub_resource type="LabelSettings" id="LabelSettings_text"]
resource_local_to_scene = true
font = ExtResource("font")
font_size = 8

[node name="ResultScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.7)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="Box" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Title" type="Label" parent="Center/Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
label_settings = SubResource("LabelSettings_title")
horizontal_alignment = 1

[node name="Swatch" type="ColorRect" parent="Center/Panel/Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_horizontal = 4
color = Color(0.6, 0.6, 0.6, 1)

[node name="Detail" type="Label" parent="Center/Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="Crowned" type="Label" parent="Center/Panel/Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="BackButton" parent="Center/Panel/Margin/Box" instance=ExtResource("join")]
