[gd_scene format=3]

[ext_resource type="Script" path="res://features/lobby/menu_screen.gd" id="1_menu"]
[ext_resource type="Theme" path="res://service/assets/ui/theme/pixel_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://features/settings/settings_button.tscn" id="5_settings"]
[ext_resource type="PackedScene" path="res://features/lobby/menu_background.tscn" id="6_bg"]

[node name="MenuScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

[node name="MenuBackground" parent="." instance=ExtResource("6_bg")]

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PanelContainer" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="CenterContainer/PanelContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 16
text = "Pixel Chiss"

[node name="CreateButton" type="Button" parent="CenterContainer/PanelContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 24)
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
text = "Crear sala"

[node name="OrLabel" type="Label" parent="CenterContainer/PanelContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6039, 0.6039, 0.6039, 1)
text = "o unete con un codigo"
horizontal_alignment = 1

[node name="CodeInput" type="LineEdit" parent="CenterContainer/PanelContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 24)
layout_mode = 2
size_flags_horizontal = 4
placeholder_text = "CODIGO"
alignment = 1
max_length = 6

[node name="JoinButton" type="Button" parent="CenterContainer/PanelContainer/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 24)
layout_mode = 2
size_flags_horizontal = 4
focus_mode = 0
text = "Unirse"

[node name="StatusLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -16.0
offset_bottom = -4.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(1, 0.7, 0.7, 1)
horizontal_alignment = 1
vertical_alignment = 1

[node name="SettingsButton" parent="." instance=ExtResource("5_settings")]

[connection signal="pressed" from="CenterContainer/PanelContainer/VBoxContainer/CreateButton" to="." method="_on_create_button_pressed"]
[connection signal="pressed" from="CenterContainer/PanelContainer/VBoxContainer/JoinButton" to="." method="_on_join_button_pressed"]
